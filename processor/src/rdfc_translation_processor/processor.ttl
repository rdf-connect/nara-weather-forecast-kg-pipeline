@prefix rdfc: <https://w3id.org/rdf-connect#>.
@prefix rdfcp: <https://w3id.org/rdf-connect/processors#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.

rdfcp:TranslationProcessor rdfc:pyImplementationOf rdfc:Processor;
    rdfs:label "Translation Processor";
    rdfs:comment "A processor to translate text using a specified ML translation model.";
    rdfc:modulePath "rdfc_translation_processor.processor";
    rdfc:class "TranslationProcessor".

[ ] a sh:NodeShape;
    sh:targetClass rdfcp:TranslationProcessor;
    sh:property [
        sh:class rdfc:Reader;
        sh:path rdfcp:input;
        sh:codeIdentifier "reader";
        sh:name "Input channel";
        sh:description "Input channel with the RDF data whose literals to translate.";
        sh:minCount 1;
        sh:maxCount 1;
    ], [
        sh:class rdfc:Writer;
        sh:path rdfcp:output;
        sh:codeIdentifier "writer";
        sh:name "Output channel";
        sh:description "Output channel with the RDF data, extended with the translated literals.";
        sh:minCount 1;
        sh:maxCount 1;
    ], [
        sh:datatype xsd:string;
        sh:path rdfcp:model;
        sh:codeIdentifier "model";
        sh:name "Model";
        sh:description "Name of the Hugging Face translation model, e.g. Helsinki-NLP/opus-mt-ja-en.";
        sh:minCount 1;
        sh:maxCount 1;
    ], [
        sh:datatype xsd:string;
        sh:path rdfcp:sourceLanguage;
        sh:codeIdentifier "source_language";
        sh:name "Source language";
        sh:description "Language tag of the literals to translate, e.g. ja.";
        sh:minCount 1;
        sh:maxCount 1;
    ], [
        sh:datatype xsd:string;
        sh:path rdfcp:targetLanguage;
        sh:codeIdentifier "target_language";
        sh:name "Target language";
        sh:description "Language tag of the translations, e.g. en.";
        sh:minCount 1;
        sh:maxCount 1;
    ].
